# Copia a .env para correr en local. (En Cloud Run estos valores se inyectan por --set-env-vars/--set-secrets.)

# --- GCP / Firestore ---
# Proyecto GCP donde está la base Firestore.
GCP_PROJECT=tu-proyecto-gcp

# --- Seguridad ---
# Clave para firmar los JWT. Genera una: openssl rand -hex 32
SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria
# "development" o "production". En production se exige SECRET_KEY fuerte y se activa HSTS.
ENVIRONMENT=development

# Orígenes CORS extra (coma-separados). Vacío = solo mismo origen (recomendado).
CORS_ORIGINS=

# --- Admin inicial (se crea solo si la colección de usuarios está vacía) ---
SEED_ADMIN_EMAIL=admin@feriakl.cl
SEED_ADMIN_PASSWORD=cambia-esta-clave-de-8-o-mas
SEED_ADMIN_NAME=Administrador

# NOTA: para correr local necesitas credenciales de GCP:
#   gcloud auth application-default login
# y tener una base Firestore creada en el proyecto (o usar el emulador con Java 21+).
