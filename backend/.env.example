# Copia este archivo a .env y ajusta los valores para correr en local.

# Base de datos. En local, SQLite (no requiere instalar nada):
DATABASE_URL=sqlite:///./feriakl.db
# En Cloud Run con Cloud SQL (Postgres), algo como:
# DATABASE_URL=postgresql+psycopg2://feriakl:CLAVE@/feriakl?host=/cloudsql/PROYECTO:REGION:INSTANCIA

# Clave para firmar los tokens JWT. Genera una aleatoria y NO la compartas.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Orígenes permitidos del frontend (separados por coma). En local:
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Usuario administrador inicial (se crea si la base está vacía).
SEED_ADMIN_EMAIL=admin@feriakl.cl
SEED_ADMIN_PASSWORD=feria1234
SEED_ADMIN_NAME=Administrador
